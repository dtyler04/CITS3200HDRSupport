# Production Environment Configuration Example
# Copy this file to .env and fill in your production values

# Flask settings
SECRET_KEY="your-production-secret-key-here-make-it-long-and-random"
FLASK_ENV=production
FLASK_DEBUG=False

# Database
DATABASE_URL=postgresql://username:password@localhost/dbname

# Flask-Mail settings  
MAIL_SERVER=smtp.yourprovider.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-app-password-here
MAIL_DEFAULT_SENDER=your-email@domain.com

# Mailchimp settings
MAILCHIMP_API_KEY=your-mailchimp-api-key-here
MAILCHIMP_SERVER_PREFIX=us21  # your server prefix
MAILCHIMP_LIST_ID=your-mailchimp-list-id

# TinyMCE Configuration
TINYMCE_LICENSE_KEY=gpl  # or your paid license key